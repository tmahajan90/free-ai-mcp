# Free AI MCP — Add your free API keys below
# Providers are tried in order. If one fails, the next is used.
# Get free keys from the URLs listed next to each provider.

# Google Gemini — 15 req/min, 1M tokens/day
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (Llama 3.3 70B) — 30 req/min, 14,400 req/day
# Get key: https://console.groq.com
GROQ_API_KEY=

# Mistral AI — Free tier
# Get key: https://console.mistral.ai
MISTRAL_API_KEY=

# Cerebras (Llama) — Free tier
# Get key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# OpenRouter (DeepSeek free) — Free models available
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
